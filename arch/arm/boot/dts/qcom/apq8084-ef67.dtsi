/*
 * Pantech EF67 common hardware description.
 *
 * Reconstructed from the IM-A930S S0226114 boot DTB (2014-09-30).
 * Keep hardware shared between S/L here; wrappers only set bootloader IDs.
 */
/memreserve/ 0xac1c0000 0x1000;

#include "apq8084-v1.1.dtsi"
#include "apq8084-mtp.dtsi"

/ {
	compatible = "qcom,apq8084-mtp", "qcom,apq8084", "qcom,mtp";

	ef67_escore_codec: escore-codec {
		compatible = "adnc,escore-codec";
		label = "escore-codec";
	};
};

&{/aliases} {
	/delete-property/ spi0;
	spi4 = "/soc/spi@f9924000";
	spi1 = "/soc/spi@f9923000";
	spi5 = "/soc/spi@f9927000";
	spi7 = "/soc/spi@f9963000";
	uart10 = "/soc/uart@f9960000";
};

&soc {
	/delete-node/ qcom,smp2pgpio-rdbg-2-in;
	/delete-node/ qcom,smp2pgpio_client_rdbg_2_in;
	/delete-node/ qcom,smp2pgpio-rdbg-2-out;
	/delete-node/ qcom,smp2pgpio_client_rdbg_2_out;
	/delete-node/ qcom,smp2pgpio-rdbg-1-in;
	/delete-node/ qcom,smp2pgpio_client_rdbg_1_in;
	/delete-node/ qcom,smp2pgpio-rdbg-1-out;
	/delete-node/ qcom,smp2pgpio_client_rdbg_1_out;
	/delete-node/ i2c@f9927000;
	/delete-node/ qcom,avtimer;

	ef67_spi_f9924000: spi@f9924000 {
		compatible = "qcom,spi-qup-v2";
		#cell-index;
		reg-names = "spi_physical", "spi_bam_physical";
		reg = <0xf9924000 0x1000 0xf9904000 0x19000>;
		interrupts = <0x00 0x60 0x00 0x00 0xee 0x00>;
		spi-max-frequency = <0xf4240>;
		qcom,master-id = <0x56>;
		qcom,use-bam;
		qcom,bam-consumer-pipe-index = <0x0e>;
		qcom,bam-producer-pipe-index = <0x0f>;
		qcom,ver-reg-exists;

		ef67_sii8620_0: sii8620@0 {
			compatible = "qcom,mhl-sii8620";
			reg = <0x00>;
			spi-max-frequency = <0xf4240>;
			#spi-cpol;
			#spi-cpha;
			#spi-cs-high;
			interrupt-parent = <&msmgpio>;
			interrupts = <0x30 0x00>;
			mhl-intr-gpio = <&msmgpio 0x30 0>;
			mhl-pwr-gpio = <&msmgpio 0x23 0>;
			mhl-rst-gpio = <&msmgpio 0x1b 0>;
			qcom,hdmi-tx-map = <&mdss_hdmi_tx>;
			mhl-switch-sel-1-gpio = <&msmgpio 0x25 0>;
			mhl-switch-sel-2-gpio = <&msmgpio 0x26 0>;
			mhl-switch-pwr-gpio = <&msmgpio 0x1f 0>;
			mhl-fw-wake-gpio = <&msmgpio 0x5e 0>;
			sii8620-vdd-supply = <&pma8084_l14>;
			qcom,vdd-voltage-level = <0x1b7740 0x1b7740>;
			qcom,vdd-current-level = <0x2328 0xc3500>;
		};
	};

	ef67_spi_f9927000: spi@f9927000 {
		compatible = "qcom,spi-qup-v2";
		cell-index = <0x05>;
		reg = <0xf9927000 0x1000 0xf9904000 0x19000>;
		reg-names = "spi_physical", "spi_bam_physical";
		interrupts = <0x00 0x63 0x00 0x00 0xee 0x00>;
		interrupt-names = "spi_irq", "spi_bam_irq";
		spi-max-frequency = <0xb71b00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		qcom,use-bam;
		qcom,bam-consumer-pipe-index = <0x14>;
		qcom,bam-producer-pipe-index = <0x15>;
		qcom,ver-reg-exists;
		qcom,master-id = <0x56>;

		ef67_knxdev_spi_0: knxdev_spi@0 {
			compatible = "tap_sensor,knxdev_spi";
			reg = <0x00>;
			spi-max-frequency = <0xb71b00>;
			spi-cpol;
			spi-cpha;
			spi-cs-high;
			interrupt-parent = <&msmgpio>;
			interrupts = <0x37 0x00>;
			tap_sensor,irq-gpio = <&msmgpio 0x37 0>;
			#interrupt-names = "irq_gpio";
			tap_sensor,gpios = <&msmgpio 0x2a 0x00 &msmgpio 0x28 0x00 &msmgpio 0x27 0x00>;
			tap_sensor,cs-gpios = <&msmgpio 0x29 0>;
		};
	};

	ef67_spi_f9963000: spi@f9963000 {
		compatible = "qcom,spi-qup-v2";
		reg = <0xf9963000 0x1000 0xf9944000 0x19000>;
		reg-names = "spi_physical", "spi_bam_physical";
		interrupts = <0x00 0x65 0x00 0x00 0xef 0x00>;
		interrupt-names = "spi_irq", "spi_bam_irq";
		spi-max-frequency = <0xb71b00>;
		qcom,gpio-mosi = <&msmgpio 0x82 0>;
		qcom,gpio-miso = <&msmgpio 0x83 0>;
		qcom,gpio-clk = <&msmgpio 0x85 0>;
		qcom,gpio-cs0 = <&msmgpio 0x84 0>;
		qcom,use-bam;
		qcom,bam-consumer-pipe-index = <0x0c>;
		qcom,bam-producer-pipe-index = <0x0d>;
		qcom,ver-reg-exists;
		qcom,master-id = <0x54>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		ef67_ix_btp_0: ix_btp@0 {
			compatible = "idex,ix_btp";
			reg = <0x00>;
			spi-max-frequency = <0xb71b00>;
			#spi-cs-high;
			interrupt-parent = <&msmgpio>;
			interrupts = <0x54 0x00>;
			idex,irq-gpio = <&msmgpio 0x54 0>;
			fpc,power-gpio = <&msmgpio 127 0>;
			fpc,reset-gpio = <&msmgpio 129 0>;
			vddio-supply = <&pma8084_l9>;
			vdd-supply = <&pma8084_l19>;
			vddaux-supply = <&pma8084_l26>;
			#interrupt-names = "irq_gpio";
			idex,gpios = <&msmgpio 0x85 0x00 &msmgpio 0x83 0x00 &msmgpio 0x82 0x00>;
			idex,cs-gpios = <&msmgpio 0x84 0>;
		};
	};

	ef67_i2c_f9967000: i2c@f9967000 {
		cell-index = <0x05>;
		compatible = "qcom,i2c-qup";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		reg-names = "qup_phys_addr";
		reg = <0xf9967000 0x1000>;
		interrupt-names = "qup_err_intr";
		interrupts = <0x00 0x69 0x00>;
		qcom,i2c-bus-freq = <0x61a80>;
		qcom,i2c-src-freq = <0x2faf080>;
		qcom,sda-gpio = <&msmgpio 0x41 0>;
		qcom,scl-gpio = <&msmgpio 0x42 0>;
		qcom,master-id = <0x54>;

		ef67_lp5523_led_driver_32: lp5523_led_driver@32 {
			compatible = "ti,lp5523_led_driver";
			reg = <0x32>;
			lp5523,clock_mode = <0x01>;
			lp5523,led_en_gpio = <&msmgpio 0x5c 0>;
			lp5523,max_chan = <0x09>;
			lp5523,led_current = <0x28>;
			lp5523,max_current = <0xfa>;
			lp5523,trg_touchkey-backlight = <0x04 0x05>;
		};
	};

	ef67_uart_f9960000: uart@f9960000 {
		compatible = "qcom,msm-hsuart-v14";
		status = "ok";
		reg = <0xf9960000 0x1000 0xf9944000 0x19000>;
		reg-names = "core_mem", "bam_mem";
		interrupts = <0x00 0x74 0x00 0x00 0xef 0x00>;
		interrupt-names = "core_irq", "bam_irq";
		qcom,bam-tx-ep-pipe-index = <0x06>;
		qcom,bam-rx-ep-pipe-index = <0x07>;
		qcom,msm-bus,name = "uart10";
		qcom,msm-bus,num-cases = <0x02>;
		qcom,msm-bus,active-only = <0x00>;
		qcom,msm-bus,num-paths = <0x01>;
		qcom,msm-bus,vectors-KBps = <0x54 0x200 0x00 0x00 0x54 0x200 0x1f4 0x320>;
	};

	ef67_gpio_switch: gpio_switch {
		compatible = "gpio_switch";

		ef67_touch_pen_detection: touch_pen_detection {
			label = "touch_pen_detection";
			debounce_time = <0x0a>;
			gpios = <0x4f>;
			flag = <0x01>;
			event_mode = <0x01>;
		};
	};

	ef67_smart_cover: smart_cover {
		compatible = "gpio-keys";
		input-name = "smart_cover";

		cover {
			label = "smart_cover";
			/* Stock flag=1: GPIO low means SW_LID closed. */
			gpios = <&msmgpio 9 1>;
			linux,input-type = <5>; /* EV_SW */
			linux,code = <0>; /* SW_LID */
			debounce-interval = <10>;
			gpio-key,wakeup;
		};
	};

	ef67_drv2603: drv2603 {
		compatible = "drv2603";

		ef67_drv2603_en: drv2603_en {
			label = "drv2603_en";
			gpios = <0x5b>;
		};
	};
};

&mdss_mdp {
	/delete-property/ qcom,mdss-has-source-split;
	/delete-node/ qcom,mdss_dsi_jdi_1080p_video;
	/delete-node/ qcom,dsi_jdi_qhd_video_0;
	/delete-node/ qcom,dsi_jdi_qhd_video_1;
	/delete-node/ qcom,mdss_dsi_jdi_qhd_dualmipi0_cmd;
	/delete-node/ qcom,mdss_dsi_jdi_qhd_dualmipi1_cmd;
	/delete-node/ qcom,dsi_jdi_4k_video_0;
	/delete-node/ qcom,dsi_jdi_4k_video_1;

	ef67_panel0: qcom,mdss_dsi_r63419_2560p_dualmipi0_ef67s_pt_cmd {
		qcom,mdss-dsi-panel-name = "r63419 2560p cmd mode dsi0 panel";
		qcom,mdss-dsi-panel-controller = <&mdss_dsi0>;
		qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
		qcom,mdss-dsi-panel-destination = "display_1";
		qcom,mdss-reset-gpio = <&msmgpio 0x60 0>;
		qcom,mdss-bl-en-gpio = <&msmgpio 0x1a 0>;
		qcom,mdss-vcip-en-gpio = <&msmgpio 0x88 0>;
		qcom,mdss-vcin-en-gpio = <&msmgpio 0x89 0>;
		qcom,mdss-vddio-reg-gpio = <&msmgpio 0x61 0>;
		qcom,mdss-te-gpio = <&msmgpio 0xc 0>;
		qcom,mdss-dsi-panel-framerate = <0x3c>;
		qcom,mdss-dsi-virtual-channel-id = <0x00>;
		qcom,mdss-dsi-stream = <0x00>;
		qcom,mdss-dsi-panel-width = <0x2d0>;
		qcom,mdss-dsi-panel-height = <0xa00>;
		qcom,mdss-dsi-h-front-porch = <0x64>;
		qcom,mdss-dsi-h-back-porch = <0x20>;
		qcom,mdss-dsi-h-pulse-width = <0x10>;
		qcom,mdss-dsi-h-sync-skew = <0x00>;
		qcom,mdss-dsi-v-back-porch = <0x03>;
		qcom,mdss-dsi-v-front-porch = <0x99>;
		qcom,mdss-dsi-v-pulse-width = <0x06>;
		qcom,mdss-dsi-h-left-border = <0x00>;
		qcom,mdss-dsi-h-right-border = <0x00>;
		qcom,mdss-dsi-v-top-border = <0x00>;
		qcom,mdss-dsi-v-bottom-border = <0x00>;
		qcom,mdss-dsi-bpp = <0x18>;
		qcom,mdss-dsi-color-order = "rgb_swap_rgb";
		qcom,mdss-dsi-underflow-color = <0xff>;
		qcom,mdss-dsi-border-color = <0x00>;
		qcom,mdss-dsi-h-sync-pulse = <0x00>;
		qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
		qcom,mdss-dsi-lane-map = "lane_map_0123";
		qcom,mdss-dsi-bllp-eof-power-mode;
		qcom,mdss-dsi-bllp-power-mode;
		qcom,mdss-dsi-lane-0-state;
		qcom,mdss-dsi-lane-1-state;
		qcom,mdss-dsi-lane-2-state;
		qcom,mdss-dsi-lane-3-state;
		qcom,mdss-dsi-panel-timings = <0x32342400 0x64682838 0x2a030400>;
		qcom,mdss-dsi-t-clk-post = <0x03>;
		qcom,mdss-dsi-t-clk-pre = <0x16>;
		qcom,mdss-dsi-bl-max-level = <0xff>;
		qcom,mdss-dsi-reset-sequence = <0x01 0xc8 0x00 0xc8 0x01 0x14>;
		qcom,mdss-dsi-dma-trigger = "trigger_sw";
		qcom,mdss-dsi-mdp-trigger = "none";
		qcom,mdss-dsi-te-pin-select = <0x01>;
		qcom,mdss-dsi-wr-mem-start = <0x2c>;
		qcom,mdss-dsi-wr-mem-continue = <0x3c>;
		qcom,mdss-dsi-te-dcs-command = <0x01>;
		qcom,mdss-dsi-te-check-enable;
		qcom,mdss-dsi-te-using-te-pin;
		qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
		qcom,mdss-dsi-on-command = [
			29 01 00 00 00 00 02 b0 00 29 01 00 00 00 00 02
			d6 01 29 01 00 00 00 00 02 b3 08 39 01 00 00 00
			00 02 51 00 39 01 00 00 00 00 02 53 0c 39 01 00
			00 00 00 02 55 03 29 01 00 00 00 00 1a ce 55 40
			43 49 55 62 71 82 94 a8 b9 cb db e9 f5 fc ff 04
			00 04 04 42 04 00 00 29 01 00 00 00 00 08 ba b5
			51 1e 10 10 a0 a0 39 01 00 00 00 00 02 35 00 39
			01 00 00 00 00 05 2a 00 00 05 9f 29 01 00 00 00
			00 10 cb e6 e0 c7 63 00 00 00 00 40 00 80 00 e8
			00 00 29 01 00 00 00 00 02 b0 03 39 01 00 00 00
			00 02 29 00 39 01 00 00 78 00 02 11 00
		];
		qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
		qcom,mdss-dsi-off-command = [39 01 00 00 14 00 02 28 00 39 01 00 00 46 00 02 10 00];
		qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
		qcom,mdss-dsi-cabc-command = [39 01 00 00 00 00 02 55 03];
		qcom,mdss-dsi-cabc-command-state = "dsi_hs_mode";
		qcom,cont-splash-enabled;
	};

	ef67_panel1: qcom,mdss_dsi_r63419_2560p_dualmipi1_ef67s_pt_cmd {
		qcom,mdss-dsi-panel-name = "r63419 2560p cmd mode dsi1 panel";
		qcom,mdss-dsi-panel-controller = <&mdss_dsi1>;
		qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
		qcom,mdss-dsi-panel-destination = "display_2";
		qcom,mdss-reset-gpio = <&msmgpio 0x60 0>;
		qcom,mdss-bl-en-gpio = <&msmgpio 0x1a 0>;
		qcom,mdss-vcip-en-gpio = <&msmgpio 0x88 0>;
		qcom,mdss-vcin-en-gpio = <&msmgpio 0x89 0>;
		qcom,mdss-vddio-reg-gpio = <&msmgpio 0x61 0>;
		qcom,mdss-te-gpio = <&msmgpio 0xc 0>;
		qcom,mdss-dsi-panel-framerate = <0x3c>;
		qcom,mdss-dsi-virtual-channel-id = <0x00>;
		qcom,mdss-dsi-stream = <0x00>;
		qcom,mdss-dsi-panel-width = <0x2d0>;
		qcom,mdss-dsi-panel-height = <0xa00>;
		qcom,mdss-dsi-h-front-porch = <0x64>;
		qcom,mdss-dsi-h-back-porch = <0x20>;
		qcom,mdss-dsi-h-pulse-width = <0x10>;
		qcom,mdss-dsi-h-sync-skew = <0x00>;
		qcom,mdss-dsi-v-back-porch = <0x03>;
		qcom,mdss-dsi-v-front-porch = <0x99>;
		qcom,mdss-dsi-v-pulse-width = <0x06>;
		qcom,mdss-dsi-h-left-border = <0x00>;
		qcom,mdss-dsi-h-right-border = <0x00>;
		qcom,mdss-dsi-v-top-border = <0x00>;
		qcom,mdss-dsi-v-bottom-border = <0x00>;
		qcom,mdss-dsi-bpp = <0x18>;
		qcom,mdss-dsi-color-order = "rgb_swap_rgb";
		qcom,mdss-dsi-underflow-color = <0xff>;
		qcom,mdss-dsi-border-color = <0x00>;
		qcom,mdss-dsi-h-sync-pulse = <0x00>;
		qcom,mdss-dsi-traffic-mode = "non_burst_sync_event";
		qcom,mdss-dsi-lane-map = "lane_map_0123";
		qcom,mdss-dsi-bllp-eof-power-mode;
		qcom,mdss-dsi-bllp-power-mode;
		qcom,mdss-dsi-lane-0-state;
		qcom,mdss-dsi-lane-1-state;
		qcom,mdss-dsi-lane-2-state;
		qcom,mdss-dsi-lane-3-state;
		qcom,mdss-dsi-panel-timings = <0x32342400 0x64682838 0x2a030400>;
		qcom,mdss-dsi-t-clk-post = <0x03>;
		qcom,mdss-dsi-t-clk-pre = <0x16>;
		qcom,mdss-dsi-bl-max-level = <0xff>;
		qcom,mdss-dsi-reset-sequence = <0x01 0xc8 0x00 0xc8 0x01 0x14>;
		qcom,mdss-dsi-dma-trigger = "trigger_sw";
		qcom,mdss-dsi-mdp-trigger = "none";
		qcom,mdss-dsi-te-pin-select = <0x01>;
		qcom,mdss-dsi-wr-mem-start = <0x2c>;
		qcom,mdss-dsi-wr-mem-continue = <0x3c>;
		qcom,mdss-dsi-te-dcs-command = <0x01>;
		qcom,mdss-dsi-te-check-enable;
		qcom,mdss-dsi-te-using-te-pin;
		qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
		qcom,mdss-dsi-on-command = [
			29 01 00 00 00 00 02 b0 00 29 01 00 00 00 00 02
			d6 01 29 01 00 00 00 00 02 b3 08 39 01 00 00 00
			00 02 51 00 39 01 00 00 00 00 02 53 0c 39 01 00
			00 00 00 02 55 03 29 01 00 00 00 00 1a ce 55 40
			43 49 55 62 71 82 94 a8 b9 cb db e9 f5 fc ff 04
			00 04 04 42 04 00 00 29 01 00 00 00 00 08 ba b5
			51 1e 10 10 a0 a0 39 01 00 00 00 00 02 35 00 39
			01 00 00 00 00 05 2a 00 00 05 9f 29 01 00 00 00
			00 10 cb e6 e0 c7 63 00 00 00 00 40 00 80 00 e8
