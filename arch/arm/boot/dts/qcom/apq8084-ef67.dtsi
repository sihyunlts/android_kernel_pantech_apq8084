		#spi-cs-high;
		interrupt-parent = <&msmgpio>;
		interrupts = <0x4b 0x00>;
		dmb,irq-gpio = <&msmgpio 0x4b 0>;
		#interrupt-names = "irq_gpio";
		dmb,gpios = <&msmgpio 0x03 0x00 &msmgpio 0x01 0x00 &msmgpio 0x00 0x00>;
		dmb,cs-gpios = <&msmgpio 0x2 0>;
	};
};

&usb3 {
	vbus_dwc3-supply = <&ef67_smb1358>;
};

&{/soc/ssusb@f9200000/dwc3@f9200000} {
	maximum-speed = "high-speed";
};

&hsphy0 {
	qcom,hsphy-init = <0xf69fa4>;
};

&{/soc/qcom,msm-thermal} {
	qcom,limit-temp = <0x5a>;
	qcom,core-limit-temp = <0x6e>;
};

&{/soc/sound} {
	qcom,audio-routing = "RX_BIAS", "MCLK", "LDO_H", "MCLK", "AIF4 MAD", "MCLK", "AMIC1", "MIC BIAS1 Internal1", "MIC BIAS1 Internal1", "Handset Mic", "AMIC2", "MIC BIAS2 External", "MIC BIAS2 External", "Headset Mic", "AMIC3", "MIC BIAS1 External", "MIC BIAS1 External", "Handset Mic", "AMIC4", "MIC BIAS3 External", "MIC BIAS3 External", "Handset Mic", "DMIC1", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic1", "DMIC2", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic2", "DMIC3", "MIC BIAS3 External", "MIC BIAS3 External", "Digital Mic3", "DMIC4", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic4";
};

&{/soc/sound-9330} {
	qcom,audio-routing = "RX_BIAS", "MCLK", "LDO_H", "MCLK", "AIF4 MAD", "MCLK", "AMIC1", "MIC BIAS1 Internal1", "MIC BIAS1 Internal1", "Handset Mic", "AMIC2", "MIC BIAS2 External", "MIC BIAS2 External", "Headset Mic", "AMIC3", "MIC BIAS1 External", "MIC BIAS1 External", "Handset Mic", "AMIC4", "MIC BIAS3 External", "MIC BIAS3 External", "Handset Mic", "DMIC1", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic1", "DMIC2", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic2", "DMIC3", "MIC BIAS3 External", "MIC BIAS3 External", "Digital Mic3", "DMIC4", "MIC BIAS1 External", "MIC BIAS1 External", "Digital Mic4";
};

&hdmi_vreg {
	/delete-property/ gpio;
};

&mdm1 {
	status = "ok";
	interrupt-map = <0 &msmgpio 0x6f 0x3 0x1 &msmgpio
		0x6d 0x3 0x2 &msmgpio 0x71 0x3
		0x3 &msmgpio 0x73 0x3>;
	qcom,mdm2ap-errfatal-gpio = <&msmgpio 0x6f 0>;
	qcom,ap2mdm-errfatal-gpio = <&msmgpio 0x70 0>;
	qcom,mdm2ap-status-gpio = <&msmgpio 0x6d 0>;
	qcom,ap2mdm-status-gpio = <&msmgpio 0x6e 0>;
	qcom,ap2mdm-soft-reset-gpio = <&msmgpio 0x80 0>;
	qcom,mdm2ap-pblrdy-gpio = <&msmgpio 0x71 0>;
	qcom,ap2mdm-vddmin-gpio = <&msmgpio 0x72 0>;
	qcom,mdm2ap-vddmin-gpio = <&msmgpio 0x73 0>;
	qcom,mdm-dual-link;
};

&{/soc/gpio_keys} {
	/delete-node/ camera_snapshot;
	/delete-node/ camera_focus;

	ef67_vol_down: vol_down {
		label = "volume_down";
		gpios = <&pma8084_gpios 0x1 0x1>;
		linux,input-type = <0x01>;
		linux,code = <0x72>;
		gpio-key,wakeup;
		debounce-interval = <0x0f>;
	};

	ef67_dome: dome {
		label = "dome";
		gpios = <&pma8084_gpios 0x15 0x1>;
		linux,input-type = <0x01>;
		linux,code = <0xfb>;
		gpio-key,wakeup;
		debounce-interval = <0x0f>;
	};
};
