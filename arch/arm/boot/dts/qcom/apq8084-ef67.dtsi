		qcom,cont-splash-enabled;
	};
};

&mdss_fb0 {
	/delete-property/ qcom,mdss-fb-splash-logo-enabled;
	qcom,memory-reservation-size = <0x1c20000>;
};

&mdss_dsi0 {
	/delete-property/ vdd-supply;
	/delete-property/ qcom,platform-reset-gpio;
	/delete-property/ qcom,platform-enable-gpio;
	/delete-property/ qcom,platform-bklight-en-gpio;
	qcom,dsi-pref-prim-pan = <&ef67_panel0>;
};

&{/soc/qcom,mdss_dsi@fd922800/qcom,panel-supply-entries} {
	/delete-node/ qcom,panel-supply-entry@1;
};

&{/soc/qcom,mdss_dsi@fd922800/qcom,panel-supply-entries/qcom,panel-supply-entry@0} {
	qcom,supply-name = "vddio";
	qcom,supply-min-voltage = <0x1b7740>;
	qcom,supply-max-voltage = <0x1b7740>;
	qcom,supply-enable-load = <0x186a0>;
};

&mdss_dsi1 {
	/delete-property/ vdd-supply;
	qcom,dsi-pref-prim-pan = <&ef67_panel1>;
};

&{/soc/qcom,mdss_dsi@fd922e00/qcom,panel-supply-entries} {
	/delete-node/ qcom,panel-supply-entry@1;
};

&{/soc/qcom,mdss_dsi@fd922e00/qcom,panel-supply-entries/qcom,panel-supply-entry@0} {
	qcom,supply-name = "vddio";
	qcom,supply-min-voltage = <0x1b7740>;
	qcom,supply-max-voltage = <0x1b7740>;
	qcom,supply-enable-load = <0x186a0>;
};

&mdss_hdmi_tx {
	/delete-property/ qcom,hdmi-tx-cec;
	/delete-property/ qcom,conditional-power-on;
	qcom,supply-names = "hpd-gdsc", "hpd-5v", "core-vdda", "core-vcc";
};

&{/soc/qcom,mpm@fc4281d0} {
	qcom,gpio-map = <
		0x03 0x01 0x04 0x05 0x05 0x08
		0x06 0x09 0x07 0x1c 0x08 0x22
		0x09 0x28 0x0a 0x2c 0x0b 0x30
		0x0c 0x34 0x0d 0x37 0x0e 0x38
		0x0f 0x3a 0x10 0x3c 0x11 0x40
		0x12 0x43 0x13 0x44 0x14 0x45
		0x15 0x4c 0x16 0x4d 0x17 0x4e
		0x18 0x4f 0x19 0x54 0x1a 0x5f
		0x1b 0x66 0x1c 0x67 0x1d 0x68
		0x1e 0x69 0x1f 0x6b 0x20 0x6d
		0x21 0x6f 0x22 0x71 0x23 0x79
