		qcom,slave-addr = <0x48>;
		qcom,cci-master = <0x00>;
		qcom,i2c-freq-mode = <0x02>;
		qcom,num-blocks = <0x08>;
		qcom,page0 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll0 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem0 = <0x06 0x7400 0x02 0x00 0x01 0x00>;
		qcom,page1 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll1 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem1 = <0x02 0x7944 0x02 0x00 0x01 0x00>;
		qcom,page2 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll2 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem2 = <0x374 0x7406 0x02 0x00 0x01 0x00>;
		qcom,page3 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll3 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem3 = <0x02 0x7946 0x02 0x00 0x01 0x00>;
		qcom,page4 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll4 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem4 = <0x02 0x793c 0x02 0x00 0x01 0x00>;
		qcom,page5 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll5 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem5 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,page6 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll6 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem6 = <0x02 0x7940 0x02 0x00 0x01 0x00>;
		qcom,page7 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,poll7 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		qcom,mem7 = <0x00 0x00 0x00 0x00 0x00 0x00>;
		cam_rvio-supply = <&pma8084_lvs4>;
		cam_rvana-supply = <&pma8084_l17>;
		qcom,cam-vreg-name = "cam_rvio", "cam_rvana";
		qcom,cam-vreg-min-voltage = <0x00 0x2b7cd0>;
		qcom,cam-vreg-max-voltage = <0x00 0x2b7cd0>;
		qcom,cam-vreg-op-mode = <0x00 0x13880>;
		qcom,gpio-no-mux = <0x00>;
		gpios = <&msmgpio 0xf 0 &msmgpio 0x7d 0
			&msmgpio 0x24 0>;
		qcom,avdd-en = <0x01>;
		qcom,gpio-reset = <0x02>;
		qcom,gpio-req-tbl-num = <0x00 0x01 0x02>;
		qcom,gpio-req-tbl-flags = <0x01 0x00 0x00>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK", "CAM0_AVDD_EN", "CAM_RESET1";
		qcom,cam-power-seq-type = "sensor_vreg", "sensor_vreg", "sensor_gpio", "sensor_gpio", "sensor_clk";
		qcom,cam-power-seq-val = "cam_rvana", "cam_rvio", "sensor_gpio_cam0_avdd_en", "sensor_gpio_reset", "sensor_cam_mclk";
		qcom,cam-power-seq-cfg-val = <0x01 0x01 0x01 0x01 0x16e3600>;
		qcom,cam-power-seq-delay = <0x01 0x01 0x03 0x03 0x03>;
	};

	ef67_flash: qcom,led-flash@a6 {
		cell-index = <0x00>;
		reg = <0xa6>;
		qcom,slave-id = <0xa6 0x00 0x00>;
		compatible = "qcom,led-flash";
		label = "lm3559";
		qcom,flash-type = <0x01>;
		qcom,cci-master = <0x00>;
		gpios = <&msmgpio 0x17 0 &msmgpio 0x18 0>;
		qcom,gpio-flash-en = <0x00>;
		qcom,gpio-flash-now = <0x01>;
		qcom,gpio-req-tbl-num = <0x00 0x01>;
		qcom,gpio-req-tbl-flags = <0x00 0x00>;
		qcom,gpio-req-tbl-label = "FLASH_EN", "FLASH_NOW";
		qcom,max-current = <0x3e8>;
		qcom,max-duration = <0x3e8>;
	};
};

