menuconfig SWITCH
	tristate "Switch class support"
	help
	  Say Y here to enable switch class support. This allows
	  monitoring switches by userspace via sysfs and uevent.

if SWITCH

config SWITCH_EF67_PEN
	bool "Pantech EF67 pen insertion switch"
	depends on MACH_APQ8084_EF67 && OF && GPIOLIB
	help
	  Report the built-in pen's insertion state through the stock
	  touch_pen_detection switch, including debounce and wakeup.

config SWITCH_GPIO
	tristate "GPIO Swith support"
	depends on GPIOLIB
	help
	  Say Y here to enable GPIO based switch support.

endif # SWITCH
